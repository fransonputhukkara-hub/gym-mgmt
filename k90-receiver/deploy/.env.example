# Copy to .env (chmod 600). Never commit .env.
POSTGRES_PASSWORD=change-me-long-random          # openssl rand -hex 24
DASHBOARD_TOKEN=change-me-at-least-16-chars      # openssl rand -hex 24 ; used to sign in to the dashboard
DOMAIN=attendance.example.com                    # DNS A record -> Oracle public IP
LETSENCRYPT_EMAIL=you@example.com
DEVICE_TIMEZONE=Asia/Kolkata                     # timezone of the K90's clock (it sends local time, no offset)
# Empty = accept any serial (first-connection capture). After first verified connection set the real serial(s):
ALLOWED_DEVICE_SERIALS=
AUTO_REGISTER_DEVICES=true
PG_DATA_DIR=/mnt/data/k90/pgdata                 # on the 200 GB block volume
LOG_LEVEL=info
