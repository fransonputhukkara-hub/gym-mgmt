# ${DOMAIN} is substituted by the nginx image entrypoint (envsubst); $vars below are nginx variables.
upstream receiver { server receiver:3000; keepalive 8; }

# --- HTTP :80 -------------------------------------------------------------------------------------------
# Device push endpoint is served over plain HTTP: the K90's ADMS push is expected to be HTTP-only (unverified;
# if the firmware offers HTTPS, switch it to the 443 block - see docs/NETWORK.md). Everything else redirects.
server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location /iclock/ {
        include /etc/nginx/device-allow.conf;
        limit_req zone=device burst=40 nodelay;
        client_max_body_size 2m;
        proxy_pass http://receiver;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite, never trust client-supplied value
        proxy_read_timeout 30s;
    }

    location = /health { proxy_pass http://receiver; }

    location / { return 301 https://$host$request_uri; }
}

# --- HTTPS :443 -----------------------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://receiver;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    # Same device endpoint over TLS, for firmware that supports HTTPS push.
    location /iclock/ {
        include /etc/nginx/device-allow.conf;
        limit_req zone=device burst=40 nodelay;
        client_max_body_size 2m;
        proxy_pass http://receiver;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location = /health { proxy_pass http://receiver; }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
